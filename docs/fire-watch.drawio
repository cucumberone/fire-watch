<mxCell id="gwnote" value="per connection:&#10;max 20 subscriptions&#10;slow consumer dropped&#10;(not buffered)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=10;fontColor=#2f5d8f;align=left;" vertex="1" parent="1"><mxGeometry x="950" y="895" width="180" height="95" as="geometry"/></mxCell>
