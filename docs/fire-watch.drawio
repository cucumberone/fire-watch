<mxfile host="app.diagrams.net" agent="fire-watch" version="24.0.0" type="device">
<diagram id="fire-watch-components" name="Fire-Watch Components">
<mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1520" math="0" shadow="0">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="ns" value="OpenShift namespace: fire-watch  ·  Route instead of Ingress  ·  no privileged pods" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#888888;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=15;fontStyle=1;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1900" height="1450" as="geometry"/></mxCell>
<mxCell id="prod" value="Event producers (external)&#10;HTTP POST -&gt; external nginx&#10;-&gt; http-ingress NodePort 30900" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#666666;fillColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="250" height="80" as="geometry" /></mxCell>
<mxCell id="facts" value="KEY FACTS&#10;&#10;1 000 events/min sustained&#10;500 evt/s storm peaks&#10;7-day retention&#10;2 048 B minimum event size&#10;msgc gzipped 3-5x at the worker&#10;&#10;No data loss:&#10;  202 only after XADD + WAIT 1&#10;  AOF everysec on every Valkey pod&#10;  min-replicas-to-write 1&#10;&#10;3 replicas, required anti-affinity&#10;23 pods total (base)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="250" height="300" as="geometry" /></mxCell>
<mxCell id="netpol" value="NETWORK EXPOSURE&#10;&#10;No NetworkPolicy objects.&#10;Namespace is shared, so a&#10;default-deny would cut off&#10;other tenants. See &#10;networking.md section 5.&#10;&#10;Constrained instead by:&#10;  ClusterIP Services&#10;  exactly 2 Routes&#10;  1 NodePort (ingress 30900)&#10;  apps use Services, not pod IPs" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="250" height="230" as="geometry" /></mxCell>
<mxCell id="legend" value="LEGEND&#10;&#10;orange   http-ingress (stateless)&#10;green    workers&#10;red      Valkey (records +&#10;         ingest stream)&#10;purple   Redis Sentinel&#10;blue     gateway / frontend&#10;grey     Route / external&#10;dashed   replication, discovery" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="250" height="210" as="geometry" /></mxCell>
<mxCell id="open" value="DECISIONS&#10;&#10;1. Durability = AOF on every&#10;   Valkey pod + WAIT 1;&#10;   no copy outside Valkey&#10;2. Node size: 128 GiB to&#10;   keep 3/3 through a&#10;   node loss&#10;3. Sentinel + bridge owns&#10;   roles and the Service&#10;4. min-replicas-to-write 1&#10;   (survive 1 Valkey loss)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="250" height="220" as="geometry" /></mxCell>
<mxCell id="rmqGroup" value="http-ingress Deployment (3) — validate · XADD fw:stream:ingest (1 MULTI per batch) · WAIT 1 · then 202" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#333333;fillColor=#fdf3e8;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="330" y="70" width="820" height="215" as="geometry" /></mxCell>
<mxCell id="rmq0" value="http-ingress-0&#10;stateless&#10;/healthz = Valkey PING" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="350" y="145" width="180" height="105" as="geometry" /></mxCell>
<mxCell id="rmq1" value="http-ingress-1&#10;stateless&#10;/healthz = Valkey PING" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="550" y="145" width="180" height="105" as="geometry" /></mxCell>
<mxCell id="rmq2" value="http-ingress-2&#10;stateless&#10;/healthz = Valkey PING" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="750" y="145" width="180" height="105" as="geometry" /></mxCell>
<mxCell id="contract" value="202 CONTRACT&#10;XADD + WAIT 1 ok -&gt; 202&#10;NOREPLICAS / short WAIT /&#10;Valkey down -&gt; 503 (nginx retries)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="950" y="145" width="180" height="105" as="geometry" /></mxCell>
<mxCell id="wrkGroup" value="Workers Deployment (3) · Node.js · consumer group workers · XACK+XDEL LAST" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#333333;fillColor=#eef7ea;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="330" width="820" height="195" as="geometry" /></mxCell>
<mxCell id="w0" value="worker-0&#10;XREADGROUP COUNT 32&#10;event-fold.lua" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="350" y="400" width="180" height="100" as="geometry" /></mxCell>
<mxCell id="w1" value="worker-1&#10;XREADGROUP COUNT 32&#10;event-fold.lua" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="550" y="400" width="180" height="100" as="geometry" /></mxCell>
<mxCell id="w2" value="worker-2&#10;XREADGROUP COUNT 32&#10;event-fold.lua" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="750" y="400" width="180" height="100" as="geometry" /></mxCell>
<mxCell id="pipeline" value="pipeline:&#10;validate -&gt; gzip msgc -&gt; hist: fork -&gt; fold -&gt; publish -&gt; XACK+XDEL&#10;retry from PEL · XAUTOCLAIM 60 s" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=10;fontColor=#2d6b1e;align=left;" vertex="1" parent="1"><mxGeometry x="950" y="400" width="180" height="100" as="geometry" /></mxCell>
<mxCell id="dfGroup" value="Valkey StatefulSet (3) — 1 master + 2 replicas · records + ingest stream · manifests only, NO operator" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#333333;fillColor=#fdeeee;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="330" y="570" width="820" height="215" as="geometry" /></mxCell>
<mxCell id="d0" value="valkey-0  (MASTER)&#10;maxmemory 40gb · PVC 64Gi&#10;AOF everysec, rotate @ 32 MB&#10;+ aof-rewriter sidecar&#10;min-replicas-to-write 1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="350" y="645" width="180" height="110" as="geometry" /></mxCell>
<mxCell id="d1" value="valkey-1  replica&#10;stable_sync&#10;own AOF · PVC 64Gi" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="550" y="645" width="180" height="110" as="geometry" /></mxCell>
<mxCell id="d2" value="valkey-2  replica&#10;stable_sync&#10;own AOF · PVC 64Gi" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="750" y="645" width="180" height="110" as="geometry" /></mxCell>
<mxCell id="keys" value="KEYS&#10;event:&lt;32hex&gt;  record (gzip msgc)&#10;idx:event:all|open|closed&#10;idx:source:{dev}&#10;hist:&lt;id&gt; + idx:history (3d)&#10;fw:stream:ingest  group workers&#10;fw:stream:dlq&#10;fw:ch:events / fw:ch:alerts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=9;fontColor=#8b2f2b;align=left;" vertex="1" parent="1"><mxGeometry x="950" y="645" width="180" height="135" as="geometry" /></mxCell>
<mxCell id="gwGroup" value="WebSocket gateway Deployment (3) + HPA 3..12 · stateless · read-only · compression-transparent" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#333333;fillColor=#eaf2fb;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="830" width="820" height="190" as="geometry"/></mxCell>
<mxCell id="g0" value="ws-gateway-0&#10;SUBSCRIBE fw:ch:events&#10;+ fw:ch:alerts" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="350" y="895" width="180" height="95" as="geometry"/></mxCell>
<mxCell id="g1" value="ws-gateway-1&#10;SUBSCRIBE fw:ch:events&#10;+ fw:ch:alerts" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="550" y="895" width="180" height="95" as="geometry"/></mxCell>
<mxCell id="g2" value="ws-gateway-2&#10;SUBSCRIBE fw:ch:events&#10;+ fw:ch:alerts" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="750" y="895" width="180" height="95" as="geometry"/></mxCell>
<mxCell id="gwnote" value="per connection:&#10;max 20 subscriptions&#10;slow consumer dropped&#10;(not buffered)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=10;fontColor=#2f5d8f;align=left;" vertex="1" parent="1"><mxGeometry x="950" y="895" width="180" height="95" as="geometry"/></mxCell>
<mxCell id="feGroup" value="Frontend Deployment (3) · nginx :8080 unprivileged · runtime config.json · CSP" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#333333;fillColor=#eaf2fb;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="1070" width="820" height="180" as="geometry"/></mxCell>
