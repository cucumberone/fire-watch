<mxCell id="f2" value="frontend-2&#10;nginx :8080" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="750" y="1135" width="180" height="90" as="geometry"/></mxCell>
<mxCell id="fenote" value="static assets only&#10;no API, no websocket&#10;hashed bundles immutable" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=10;fontColor=#2f5d8f;align=left;" vertex="1" parent="1"><mxGeometry x="950" y="1135" width="180" height="90" as="geometry"/></mxCell>
<mxCell id="sntGroup" value="Redis Sentinel StatefulSet (3)&#10;quorum 2 · down-after-ms 5000&#10;resolves pod hostnames" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#333333;fillColor=#f6f0fa;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1180" y="570" width="320" height="215" as="geometry"/></mxCell>
