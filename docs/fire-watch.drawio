<mxfile host="app.diagrams.net" agent="fire-watch" version="24.0.0" type="device">
<diagram id="fire-watch-components" name="Fire-Watch Components">
<mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1520" math="0" shadow="0">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="ns" value="OpenShift namespace: fire-watch  ·  Route instead of Ingress  ·  no privileged pods" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#888888;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=15;fontStyle=1;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1900" height="1450" as="geometry"/></mxCell>
<mxCell id="prod" value="Event producers (external)&#10;AMQP publish + publisher confirms" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#666666;fillColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="250" height="80" as="geometry"/></mxCell>
<mxCell id="facts" value="KEY FACTS&#10;&#10;1 000 events/min sustained&#10;500 evt/s storm peaks&#10;7-day retention&#10;2 048 B minimum event size&#10;msgc gzipped 3-5x at the worker&#10;&#10;No data loss:&#10;  RabbitMQ audit queue = WAL&#10;  (Dragonfly has NO AOF)&#10;&#10;3 replicas, required anti-affinity&#10;19 pods total" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="250" height="300" as="geometry"/></mxCell>
<mxCell id="netpol" value="NETWORK EXPOSURE&#10;&#10;No NetworkPolicy objects.&#10;Namespace is shared, so a&#10;default-deny would cut off&#10;other tenants. See &#10;networking.md section 5.&#10;&#10;Constrained instead by:&#10;  ClusterIP-only Services&#10;  exactly 2 Routes&#10;  no NodePort / no hostNetwork&#10;  apps use Services, not pod IPs" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="250" height="230" as="geometry"/></mxCell>
<mxCell id="legend" value="LEGEND&#10;&#10;orange   RabbitMQ / quorum&#10;orange*  audit WAL queue&#10;green    workers&#10;red      DragonflyDB&#10;purple   Redis Sentinel&#10;blue     gateway / frontend&#10;grey     Route / external&#10;dashed   quorum, replication,&#10;         discovery, replay" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="250" height="210" as="geometry"/></mxCell>
<mxCell id="open" value="BLOCKING DECISIONS&#10;&#10;1. Accept RabbitMQ-as-WAL&#10;   instead of AOF (R1)&#10;2. Node size: 48Gi/128 GiB&#10;   to keep 3/3 through a&#10;   node loss&#10;3. Sentinel + bridge owns&#10;   roles and the Service&#10;4. FW_ALERT_DEDUP_WINDOW&#10;   vs sensor interval" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="250" height="220" as="geometry"/></mxCell>
<mxCell id="rmqGroup" value="RabbitMQ StatefulSet (3) — quorum queues, peer discovery via k8s plugin" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#333333;fillColor=#fdf3e8;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="330" y="70" width="820" height="215" as="geometry"/></mxCell>
<mxCell id="rmq0" value="rabbitmq-0&#10;PVC 96Gi&#10;cluster seed" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="350" y="145" width="180" height="105" as="geometry"/></mxCell>
<mxCell id="rmq1" value="rabbitmq-1&#10;PVC 96Gi&#10;quorum member" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="550" y="145" width="180" height="105" as="geometry"/></mxCell>
<mxCell id="rmq2" value="rabbitmq-2&#10;PVC 96Gi&#10;quorum member" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="750" y="145" width="180" height="105" as="geometry"/></mxCell>
<mxCell id="audit" value="q.audit.events — WRITE-AHEAD LOG&#10;quorum · 7d TTL · 64GiB cap&#10;PLAIN JSON (never compressed)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="950" y="145" width="180" height="105" as="geometry"/></mxCell>
<mxCell id="wrkGroup" value="Workers Deployment (3) · Node.js · ack LAST" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#333333;fillColor=#eef7ea;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="330" width="820" height="195" as="geometry"/></mxCell>
<mxCell id="w0" value="worker-0&#10;prefetch 32&#10;alert-fold.lua" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="350" y="400" width="180" height="100" as="geometry"/></mxCell>
<mxCell id="w1" value="worker-1&#10;prefetch 32&#10;alert-fold.lua" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="550" y="400" width="180" height="100" as="geometry"/></mxCell>
<mxCell id="w2" value="worker-2&#10;prefetch 32&#10;alert-fold.lua" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="750" y="400" width="180" height="100" as="geometry"/></mxCell>
<mxCell id="pipeline" value="pipeline:&#10;validate -&gt; gzip msgc -&gt; write -&gt; audit copy -&gt; publish -&gt; ack" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=10;fontColor=#2d6b1e;align=left;" vertex="1" parent="1"><mxGeometry x="950" y="400" width="180" height="100" as="geometry"/></mxCell>
<mxCell id="dfGroup" value="DragonflyDB StatefulSet (3) — 1 master + 2 replicas · manifests only, NO operator" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#333333;fillColor=#fdeeee;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="330" y="570" width="820" height="215" as="geometry"/></mxCell>
<mxCell id="d0" value="dragonfly-0  (MASTER)&#10;+ dragonfly-write-guard sidecar&#10;maxmemory 36gb · PVC 64Gi&#10;snapshot_cron hourly" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="350" y="645" width="180" height="110" as="geometry"/></mxCell>
<mxCell id="d1" value="dragonfly-1  replica&#10;stable_sync&#10;PVC 64Gi" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="550" y="645" width="180" height="110" as="geometry"/></mxCell>
<mxCell id="d2" value="dragonfly-2  replica&#10;stable_sync&#10;PVC 64Gi" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="750" y="645" width="180" height="110" as="geometry"/></mxCell>
<mxCell id="keys" value="KEYS&#10;fw:evt:{id}      payload (gzip msgc)&#10;fw:idx:src:{s}   7d pruned index&#10;fw:alert:{key}   state+count+wm&#10;fw:alert:open:{key}&#10;fw:ch:events     pub/sub&#10;fw:ch:alerts     pub/sub" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=9;fontColor=#8b2f2b;align=left;" vertex="1" parent="1"><mxGeometry x="950" y="645" width="180" height="110" as="geometry"/></mxCell>
<mxCell id="gwGroup" value="WebSocket gateway Deployment (3) + HPA 3..12 · stateless · read-only · compression-transparent" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#333333;fillColor=#eaf2fb;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="830" width="820" height="190" as="geometry"/></mxCell>
