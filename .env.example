# ---------------------------------------------------------------------------
# fire-watch — deployment secrets
#
# This is the TEMPLATE. Real values never enter git:
#   cp .env.example .env
#   ./scripts/create-secrets.sh
#
# .gitignore covers `.env`, `.env.*` and `*.env`. Verify with:
#   git check-ignore -v .env
# ---------------------------------------------------------------------------

NAMESPACE=fire-watch

# ---------------------------------------------------------------------------
# RabbitMQ — Secret `fire-watch-rabbitmq` {username,password}
#
# This is the ONLY account: definitions.json deliberately contains no users, so
# RABBITMQ_DEFAULT_USER/PASS is what creates it on first boot.
#
# Generate a password with:
#   openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | cut -c1-32
# ---------------------------------------------------------------------------
AMQP_USER=fw
AMQP_PASS=__GENERATE__

# ---------------------------------------------------------------------------
# Dragonfly — Secret `fire-watch-dragonfly` {password}
#
# Used by: dragonfly --requirepass, every sentinel `auth-pass`, workers,
# ws-gateway, sentinel-bridge, redis-exporter.
#
# 32 alphanumeric chars, deliberately NOT base64: this value is substituted into
# sentinel.conf with sed, and a `/` in a base64 string would either break the
# substitution or produce a config redis cannot parse.
# ---------------------------------------------------------------------------
DRAGONFLY_PASSWORD=__GENERATE__

# ---------------------------------------------------------------------------
# HTTP ingress — Secret `fire-watch-ingress` {token}
#
# Sent by producers as `Authorization: Bearer <token>`.
#   openssl rand -hex 32
# ---------------------------------------------------------------------------
FW_INGEST_TOKEN=__GENERATE__

# ---------------------------------------------------------------------------
# Not secrets — recorded so one file has the whole picture
# ---------------------------------------------------------------------------
AMQP_HOST=rabbitmq.fire-watch.svc.cluster.local
AMQP_PORT=5672
DFLY_MASTER_NAME=fire-watch-dragonfly
