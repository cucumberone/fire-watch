<mxCell id="bridge" value="sentinel-bridge Deployment&#10;issues REPLICAOF · patches svc/valkey selector&#10;emits fw:ch:alerts" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1180" y="800" width="320" height="70" as="geometry"/></mxCell>
